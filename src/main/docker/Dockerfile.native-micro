####
# Native executable on the Quarkus micro base image (same base as the Jib release image).
# Build the executable first, then the image (or use docker-compose.yml at the repo root):
#
# ./mvnw package -Dnative -DskipTests
# docker build -f src/main/docker/Dockerfile.native-micro -t restok:local .
###
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
